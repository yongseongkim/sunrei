{
  "name": "recommendation-system",
  "version": "1.0.0",
  "description": "A recommendation system that suggests locations in popular animation or drama.",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:local": "NODE_ENV=local node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "dev": "NODE_ENV=local ts-node -r tsconfig-paths/register src/main.ts",
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "codegen": "rm -rf src/dto && openapi-generator-cli generate -i ../sunrei-api/openapi.yaml -g typescript-fetch -o src/dto --additional-properties=typescriptThreePlus=true --global-property=models,supportingFiles",
    "db:reset": "docker-compose down -v && docker-compose up -d && sleep 5 && npm run script:seed",
    "script:seed": "ts-node -r tsconfig-paths/register src/scripts/seed-runner.ts",
    "script:fetch-place-ids": "ts-node -r tsconfig-paths/register src/scripts/fetch-place-ids.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.5.0",
    "pg": "^8.13.1",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.22",
    "ulid": "^3.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@openapitools/openapi-generator-cli": "^2.20.2",
    "@types/express": "^5.0.3",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "author": "Your Name",
  "license": "MIT"
}

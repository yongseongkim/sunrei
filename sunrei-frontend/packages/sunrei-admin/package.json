{
  "name": "sunrei-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "clean": "rm -rf .next node_modules",
    "codegen": "rm -rf src/api/admin && openapi-generator-cli generate -i ../../../sunrei-api/admin-api-spec.yaml -g typescript-axios -o src/api/admin --additional-properties=typescriptThreePlus=true,apiPackage=admin,modelPackage=admin --global-property=apiDocs=false,modelDocs=false"
  },
  "dependencies": {
    "@googlemaps/react-wrapper": "^1.2.0",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "cmdk": "^1.1.1",
    "js-cookie": "^3.0.5",
    "react-hook-form": "^7.62.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.23.1",
    "@types/google.maps": "^3.58.1",
    "@types/js-cookie": "^3.0.6"
  }
}

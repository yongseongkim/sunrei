{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "nameMatches",
    "areaMatches",
    "premisesMatches",
    "reason"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "held"
      ]
    },
    "nameMatches": {
      "type": "boolean"
    },
    "areaMatches": {
      "type": "boolean"
    },
    "premisesMatches": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    }
  }
}
